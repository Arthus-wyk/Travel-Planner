  "update_travel_profile": {
    "$defs": {
      "TravelProfileUpdates": {
        "additionalProperties": false,
        "properties": {
          "destination": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Destination"
          },
          "start_date": {
            "anyOf": [
              {
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date"
          },
          "end_date": {
            "anyOf": [
              {
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Date"
          },
          "departure_city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Departure City"
          },
          "travelers": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Travelers"
          },
          "budget": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "travel_style": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Travel Style"
          },
          "interests": {
            "anyOf": [
              {
                "description": "Preferred activities and themes.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interests"
          },
          "constraints": {
            "anyOf": [
              {
                "description": "Dietary, mobility, accommodation, or other trip restrictions.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Constraints"
          },
          "pace": {
            "anyOf": [
              {
                "description": "Requested trip tempo, for example relaxed.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pace"
          },
          "notes": {
            "anyOf": [
              {
                "description": "Other trip-specific requests that do not fit another field.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "required": [
          "destination",
          "start_date",
          "end_date",
          "departure_city",
          "travelers",
          "budget",
          "currency",
          "travel_style",
          "interests",
          "constraints",
          "pace",
          "notes"
        ],
        "title": "TravelProfileUpdates",
        "type": "object"
      }
    },
    "properties": {
      "plan_id": {
        "title": "Plan Id",
        "type": "string"
      },
      "updates": {
        "$ref": "#/$defs/TravelProfileUpdates"
      }
    },
    "required": [
      "plan_id",
      "updates"
    ],
    "title": "update_travel_profileArguments",
    "type": "object"
  },
