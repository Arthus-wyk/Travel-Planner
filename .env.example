LLM_PROVIDER=siliconflow
LLM_BASE_URL=https://ollama.com
LLM_API_KEY=

SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=

# Review child output limit. 0 uses the provider default. Set to 8192 for an explicit limit.
REVIEW_CHILD_MAX_TOKENS=0

AMAP_API_KEY=
AMAP_TIMEOUT_SECONDS=10

# Optional inbound HTTP/WebSocket body diagnostics, limited to 16 KiB per body.
TRAVEL_LOG_HTTP_BODY=0
